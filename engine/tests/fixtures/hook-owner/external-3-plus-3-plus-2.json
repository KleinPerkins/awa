{
  "version": 1,
  "hooks": {
    "sessionStart": [
      {
        "command": "{{RUNTIME}}/kernel/hooks/worktree-session.sh",
        "type": "command",
        "timeout": 5,
        "failClosed": false
      },
      {
        "command": "{{HOST_ROOT}}/hooks/session-context-delegator.sh",
        "type": "command",
        "timeout": 5,
        "failClosed": false
      },
      {
        "command": "{{RUNTIME}}/kernel/hooks/awa-recovery-maintenance.sh",
        "type": "command",
        "timeout": 5,
        "failClosed": false
      }
    ],
    "beforeShellExecution": [
      {
        "command": "{{RUNTIME}}/kernel/hooks/worktree-guard.sh",
        "type": "command",
        "timeout": 20,
        "failClosed": false
      },
      {
        "command": "{{HOST_ROOT}}/hooks/shell-guard-delegator.sh",
        "type": "command",
        "timeout": 20,
        "failClosed": false
      }
    ],
    "afterFileEdit": [
      {
        "command": "{{RUNTIME}}/kernel/hooks/worktree-guard.sh",
        "type": "command",
        "timeout": 20
      },
      {
        "command": "{{HOST_ROOT}}/hooks/file-observer-delegator.sh",
        "type": "command",
        "timeout": 20
      }
    ],
    "beforeSubmitPrompt": [
      {
        "command": "{{RUNTIME}}/kernel/hooks/before-submit-prompt.sh",
        "type": "command",
        "matcher": "UserPromptSubmit",
        "timeout": 20,
        "failClosed": false
      }
    ],
    "beforeReadFile": [
      {
        "command": "{{HOST_ROOT}}/foreign/sentinel.sh",
        "type": "command",
        "timeout": 7
      }
    ]
  }
}
