                      "length_bucket": {
                        "enum": [
                          "1_64",
                          "65_256",
                          "257_4096",
                          "OVER_4096"
                        ]
                      }
                    }
                  }
                }
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "turn_label": {
                "type": "string"
              }
            }
          },
          "then": {
            "properties": {
              "session_label": {
                "type": "string"
              }
            }
