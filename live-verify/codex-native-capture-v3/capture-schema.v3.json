          }
        },
        {
          "if": {
            "properties": {
              "session_label": {
                "type": "string"
              }
            }
          },
          "then": {
            "properties": {
              "identity_presence": {
                "properties": {
                  "session": {
                    "properties": {
                      "type": {
                        "const": "STRING"
                      },
                      "length_bucket": {
                        "enum": [
                          "1_64",
                          "65_256",
                          "257_4096",
                          "OVER_4096"
                        ]
                      }
                    }
                  }
                }
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "turn_label": {
                "type": "string"
              }
            }
          },
          "then": {
            "properties": {
              "identity_presence": {
                "properties": {
                  "turn": {
                    "properties": {
                      "type": {
                        "const": "STRING"
