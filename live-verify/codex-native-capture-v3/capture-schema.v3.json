{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Closed native Codex first-prompt capture v3: controller-bound, UNPROVEN only",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schema": {
      "const": "awa-codex-capture-export/v3"
    },
    "run_label": {
      "type": "string",
      "pattern": "^C[1-9][0-9]{0,2}$"
    },
    "input_sha256": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "README.md": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "capture_hook.py": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "verify_capture.py": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "capture-schema.v3.json": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "scenario-catalog.v3.json": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "forbidden-fields.v3.txt": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "fixture-hooks.v3.json.in": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        }
      },
      "required": [
        "README.md",
        "capture_hook.py",
        "verify_capture.py",
        "capture-schema.v3.json",
        "scenario-catalog.v3.json",
        "forbidden-fields.v3.txt",
        "fixture-hooks.v3.json.in"
      ]
    },
    "events": {
      "type": "array",
      "maxItems": 2,
      "items": {
        "$ref": "#/$defs/event"
      },
      "minItems": 2
    },
    "scenarios": {
      "type": "array",
      "minItems": 1,
      "maxItems": 1,
      "items": {
        "$ref": "#/$defs/scenario"
      }
    },
    "session_scope": {
      "const": "CONTROLLER_BOUND"
    },
    "collector_contention": {
      "const": "NOT_RECORDED"
    }
  },
  "required": [
    "schema",
    "run_label",
    "input_sha256",
    "events",
    "scenarios",
    "session_scope",
    "collector_contention"
  ],
  "$defs": {
    "event": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "schema": {
          "const": "awa-codex-capture-event/v3"
        },
        "run_label": {
          "type": "string",
          "pattern": "^C[1-9][0-9]{0,2}$"
        },
        "scenario_id": {
          "const": "A02"
        },
        "sequence": {
          "type": "integer",
          "minimum": 1,
          "maximum": 8192
        },
        "event_name": {
          "const": "UserPromptSubmit"
        },
        "source": {
          "type": "null"
        },
        "session_label": {
          "const": "S1"
        },
        "turn_label": {
          "anyOf": [
            {
              "type": "null"
            },
            {
              "type": "string",
              "pattern": "^T(?:[1-9]|[1-9][0-9]|[1-9][0-9]{2}|1[0-9]{3}|20[0-3][0-9]|204[0-8])$"
            }
          ]
        },
        "root_label": {
          "const": "R1"
        },
        "identity_presence": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "session": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "presence": {
                  "enum": [
                    "PRESENT",
                    "MISSING"
                  ]
                },
                "type": {
                  "enum": [
                    "STRING",
                    "NULL",
                    "OTHER"
                  ]
                },
                "length_bucket": {
                  "enum": [
                    null,
                    "EMPTY",
                    "1_64",
                    "65_256",
                    "257_4096",
                    "OVER_4096"
                  ]
                }
              },
              "required": [
                "presence",
                "type",
                "length_bucket"
              ],
              "allOf": [
                {
                  "if": {
                    "properties": {
                      "type": {
                        "const": "STRING"
                      }
                    }
                  },
                  "then": {
                    "properties": {
                      "length_bucket": {
                        "enum": [
                          "EMPTY",
                          "1_64",
                          "65_256",
                          "257_4096",
                          "OVER_4096"
                        ]
                      }
                    }
                  },
                  "else": {
                    "properties": {
                      "length_bucket": {
                        "type": "null"
                      }
                    }
                  }
                },
                {
                  "if": {
                    "properties": {
                      "presence": {
                        "const": "MISSING"
                      }
                    }
                  },
                  "then": {
                    "properties": {
                      "type": {
                        "const": "NULL"
                      },
                      "length_bucket": {
                        "type": "null"
                      }
                    }
                  }
                }
              ]
            },
            "turn": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "presence": {
                  "enum": [
                    "PRESENT",
                    "MISSING"
                  ]
                },
                "type": {
                  "enum": [
                    "STRING",
                    "NULL",
                    "OTHER"
                  ]
                },
                "length_bucket": {
                  "enum": [
                    null,
                    "EMPTY",
                    "1_64",
                    "65_256",
                    "257_4096",
                    "OVER_4096"
                  ]
                }
              },
              "required": [
                "presence",
                "type",
                "length_bucket"
              ],
              "allOf": [
                {
                  "if": {
                    "properties": {
                      "type": {
                        "const": "STRING"
                      }
                    }
                  },
                  "then": {
                    "properties": {
                      "length_bucket": {
                        "enum": [
                          "EMPTY",
                          "1_64",
                          "65_256",
                          "257_4096",
                          "OVER_4096"
                        ]
                      }
                    }
                  },
                  "else": {
                    "properties": {
                      "length_bucket": {
                        "type": "null"
                      }
                    }
                  }
                },
                {
                  "if": {
                    "properties": {
                      "presence": {
                        "const": "MISSING"
                      }
                    }
                  },
                  "then": {
                    "properties": {
                      "type": {
                        "const": "NULL"
                      },
                      "length_bucket": {
                        "type": "null"
                      }
                    }
                  }
                }
              ]
            },
            "cwd": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "presence": {
                  "enum": [
                    "PRESENT",
                    "MISSING"
                  ]
                },
                "type": {
                  "enum": [
                    "STRING",
                    "NULL",
                    "OTHER"
                  ]
                },
                "length_bucket": {
                  "enum": [
                    null,
                    "EMPTY",
                    "1_64",
                    "65_256",
                    "257_4096",
                    "OVER_4096"
                  ]
                }
              },
              "required": [
                "presence",
                "type",
                "length_bucket"
              ],
              "allOf": [
                {
                  "if": {
                    "properties": {
                      "type": {
                        "const": "STRING"
                      }
                    }
                  },
                  "then": {
                    "properties": {
                      "length_bucket": {
                        "enum": [
                          "EMPTY",
                          "1_64",
                          "65_256",
                          "257_4096",
                          "OVER_4096"
                        ]
                      }
                    }
                  },
                  "else": {
                    "properties": {
                      "length_bucket": {
                        "type": "null"
                      }
                    }
                  }
                },
                {
                  "if": {
                    "properties": {
                      "presence": {
                        "const": "MISSING"
                      }
                    }
                  },
                  "then": {
                    "properties": {
                      "type": {
                        "const": "NULL"
                      },
                      "length_bucket": {
                        "type": "null"
                      }
                    }
                  }
                }
              ]
            }
          },
          "required": [
            "session",
            "turn",
            "cwd"
          ]
        },
        "tool_class": {
          "type": "null"
        },
        "tool_discriminator": {
          "type": "null"
        },
        "hook_outcome": {
          "const": "OBSERVED"
        },
        "ordering_counter": {
          "type": "integer",
          "minimum": 1,
          "maximum": 8192
        },
        "timing_bucket": {
          "enum": [
            "LT_10MS",
            "LT_100MS",
            "LT_1S",
            "LT_5S",
            "GTE_5S"
          ]
        },
        "process_exit_class": {
          "const": "NOT_APPLICABLE"
        }
      },
      "required": [
        "schema",
        "run_label",
        "scenario_id",
